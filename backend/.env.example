# ==========================================
# Deep Research Agent 2.0 配置环境示例
# ==========================================

# 大模型接口配置 (兼容 OpenAI 标准接口协议)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# You.com 智能搜索与网页清洗 API (高精度商业化检索)
YDC_API_KEY=your_you_com_api_key_here

# Tavily 搜索引擎 API (可选)
TAVILY_API_KEY=

# Jina Reader API (可选)
JINA_API_KEY=

# 检索与爬虫配置
MAX_SEARCH_RESULTS=5
SCRAPER_TIMEOUT=15.0
